@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=IBM+Plex+Sans:wght@400;500;600&display=swap');

:root {
  --paper: #14171c;
  --paper-dim: #1a1e24;
  --ink: #e9e4d8;
  --rule: rgba(233, 228, 216, 0.14);
  --rule-strong: rgba(233, 228, 216, 0.22);
  --green: #6fae93;
  --rust: #cf9a5f;
  --muted: #948d80;
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: 17px;
  line-height: 1.55;
}

a {
  color: inherit;
  text-decoration-thickness: 1px;
  text-underline-offset: 3px;
}

h1, h2, h3 {
  font-family: 'Fraunces', serif;
  font-weight: 500;
  margin: 0;
  letter-spacing: -0.01em;
}

.wrap {
  max-width: 780px;
  margin: 0 auto;
  padding: 0 24px;
}

/* ---------- Header / cover ---------- */

.cover {
  padding: 72px 0 40px;
  border-bottom: 1px solid var(--rule);
}

.cover .kicker {
  color: var(--muted);
  font-size: 15px;
  margin-bottom: 10px;
}

.cover h1 {
  font-size: 46px;
  line-height: 1.1;
}

.cover p.tagline {
  margin-top: 14px;
  color: var(--muted);
  max-width: 46ch;
  font-size: 17px;
}

.back-link {
  display: inline-block;
  margin-bottom: 22px;
  color: var(--green);
  font-size: 15px;
}

/* ---------- Binder tabs (home page) ---------- */

.binder {
  padding: 8px 0 80px;
}

.tab {
  display: flex;
  align-items: stretch;
  border-bottom: 1px solid var(--rule);
  text-decoration: none;
  color: var(--ink);
  padding: 26px 0;
  gap: 24px;
}

.tab:first-child { padding-top: 34px; }

.tab-index {
  flex: 0 0 auto;
  width: 34px;
  font-family: 'Fraunces', serif;
  font-size: 20px;
  color: var(--muted);
  padding-top: 2px;
}

.tab-body h2 {
  font-size: 26px;
  margin-bottom: 6px;
}

.tab-body p {
  margin: 0;
  color: var(--muted);
  font-size: 15px;
}

.tab-arrow {
  margin-left: auto;
  align-self: center;
  color: var(--green);
  font-family: 'Fraunces', serif;
  font-size: 22px;
}

/* ---------- Chapter list (class pages) ---------- */

.chapters {
  padding: 8px 0 80px;
}

.chapter {
  padding: 26px 0;
  border-bottom: 1px solid var(--rule);
  display: flex;
  gap: 20px;
}

.chapter-num {
  flex: 0 0 auto;
  width: 30px;
  font-family: 'Fraunces', serif;
  color: var(--muted);
  font-size: 17px;
  padding-top: 1px;
}

.chapter-title {
  font-size: 19px;
  margin-bottom: 10px;
}

.chapter-links {
  display: flex;
  gap: 22px;
  flex-wrap: wrap;
}

.doc-link {
  font-size: 15px;
  color: var(--green);
  border-bottom: 1px solid rgba(111, 174, 147, 0.4);
  padding-bottom: 1px;
}

.doc-link.fiche {
  color: var(--rust);
  border-bottom-color: rgba(207, 154, 95, 0.4);
}

.doc-link.missing {
  color: var(--muted);
  border-bottom-color: var(--rule);
  cursor: default;
}

.note {
  margin-top: 40px;
  padding-top: 20px;
  border-top: 1px dashed var(--rule);
  color: var(--muted);
  font-size: 14px;
  max-width: 60ch;
}

footer {
  padding: 30px 0 60px;
  color: var(--muted);
  font-size: 13px;
}
